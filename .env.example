# --- Postgres (used by docker-compose and DATABASE_URL below) ---
# Dev-only placeholder credentials. Never reuse these values outside a local machine.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=alpha_trade_db

DATABASE_URL=postgresql://postgres:change-me-in-your-local-env@localhost:5432/alpha_trade_db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- AI analysis microservice (market data, signals, AI Guide chat/RAG) ---
AI_ENGINE_URL=http://localhost:8000

# --- Auth ---
JWT_SECRET=change-me-in-your-local-env

# --- Admin access (comma-separated emails allowed to edit the AI Guide's
# config and view the feedback log). Blocked for everyone if left unset —
# to test those pages locally, put your own dev account's email here. ---
ADMIN_EMAILS=

# --- Shared secret between apps/api and packages/ai-engine (optional in
# local dev; required in production so the AI engine's public URL can't be
# called directly by anyone who finds it) ---
AI_ENGINE_SHARED_SECRET=

# --- CORS: the web app's origin (leave unset in local dev to allow any origin) ---
WEB_ORIGIN=

# --- OpenRouter (powers the AI Guide chat + RAG, and workflow intent classification) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Google Gemini (AI Insight Reports / Market News Explainer / Company Reports only — NOT the AI Guide chat) ---
GEMINI_API_KEY=

# --- Telegram bot (optional — bot stays disabled if unset) ---
TELEGRAM_BOT_TOKEN=

# --- Resend (daily report emails, optional — feature disabled if unset) ---
RESEND_API_KEY=

# --- Stripe (AI Guide chatbot $5 paywall, optional — chat is unlocked if unset) ---
# Get a test-mode key at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# --- Web app ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
