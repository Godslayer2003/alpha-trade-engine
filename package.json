{
  "name": "alpha-trade-engine",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/shared-types",
    "packages/database"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,ai -c blue,green,yellow \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:ai\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:ai": "cd packages/ai-engine && uvicorn app.main:app --reload --port 8000",
    "build": "npm run build --workspace=packages/shared-types && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/api",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "prisma:generate": "prisma generate --schema packages/database/prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prisma": "^5.20.0",
    "typescript": "^5.6.3"
  }
}
