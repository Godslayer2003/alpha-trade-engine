{
  "name": "alpha-trade-engine",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/shared-types",
    "packages/database",
    "packages/ai-engine"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,ai -c blue,green,yellow \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:ai\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:ai": "npm run build --workspace=packages/ai-engine && npm run dev --workspace=packages/ai-engine",
    "build": "npm run build --workspace=packages/shared-types && npm run build --workspace=packages/ai-engine && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/api",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "test:web-quality": "node scripts/web-quality.cjs",
    "prisma:generate": "prisma generate --schema packages/database/prisma/schema.prisma"
  },
  "overrides": {
    "multer": "2.4.0",
    "shell-quote": "1.12.0",
    "postcss-selector-parser": "7.1.6",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  },
  "devDependencies": {
    "@istanbuljs/load-nyc-config": "1.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "concurrently": "^9.1.0",
    "prisma": "^5.20.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.3"
  }
}
