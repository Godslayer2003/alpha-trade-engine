datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum InvestmentStyle {
  SWING_TRADING
  WEEKEND_POSITIONING
  LONG_TERM_HOLD
  DAY_TRADING
  OPTIONS_INCOME
}

enum DealType {
  LONG
  SHORT
  NEUTRAL
}

enum RiskTolerance {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

// Mirrors packages/shared-types AssetClass.
enum AssetClass {
  EQUITY
  CRYPTO
  COMMODITY
}

enum TradeSide {
  BUY
  SELL
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  termsAcceptedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile        UserProfile?
  strategies     UserStrategy[]
  portfolios     Portfolio[]
  brokerAccounts BrokerAccount[]
  savedAnalyses  ChartAnalysis[]
  recommendations Recommendation[]
  telegramLink   TelegramLink?
}

model UserProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String?
  lastName          String?
  country           String?
  riskTolerance     RiskTolerance @default(MODERATE)
  capitalBase       Float         @default(10000.0)
  investmentGoal    String?
  timeHorizonYears  Int?
  experienceLevel   String?
  age               Int?
  gender            Gender?
  profilePictureUrl String?

  // Notification preferences (daily portfolio report).
  notificationEmail    String?
  dailyReportEnabled   Boolean   @default(false)
  dailyReportTime      String    @default("07:00")
  dailyReportTimezone  String    @default("UTC")
  dailyReportChannels  String[]  @default([])
  lastDailyReportSentAt DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model UserStrategy {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  style            InvestmentStyle
  preferredTickers String[]
  maxRiskPerTrade  Float           @default(0.02)
  notes            String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
}

model Recommendation {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker       String
  assetClass   AssetClass
  dealType     DealType
  horizonStyle InvestmentStyle
  entryPrice   Float
  stopLoss     Float?
  targetPrice  Float?
  justification String
  createdAt    DateTime        @default(now())
}

model AiReport {
  id          String     @id @default(uuid())
  symbol      String
  assetClass  AssetClass
  periodLabel String
  content     String
  grounded    Boolean    @default(false)
  generatedAt DateTime   @default(now())

  @@index([symbol, assetClass, periodLabel])
}

model MoverScan {
  id        String   @id @default(uuid())
  scanDate  String   @unique
  movers    Json
  createdAt DateTime @default(now())
}

enum AssistantRating {
  UP
  DOWN
}

// Singleton row (id fixed to "singleton") holding the live, editable AI
// Guide prompt + knowledge base. Falls back to defaults.ts constants when
// no row exists yet — DB-backed rather than a flat file so edits survive
// Railway redeploys.
model AssistantConfig {
  id            String   @id @default("singleton")
  systemPrompt  String
  knowledgeBase String
  updatedAt     DateTime @updatedAt
}

model AssistantFeedback {
  id             String          @id @default(uuid())
  question       String
  answer         String
  rating         AssistantRating
  model          String
  responseTimeMs Int
  inputTokens    Int
  outputTokens   Int
  createdAt      DateTime        @default(now())
}

model TelegramLink {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String?   @unique
  linkCode  String    @unique
  linkedAt  DateTime?
  createdAt DateTime  @default(now())
}

model ChartAnalysis {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker            String
  timeframe         String
  detectedPattern   String
  dealType          DealType
  suggestedEntry    Float
  suggestedStopLoss Float
  suggestedTarget   Float
  riskRewardRatio   Float
  confidenceScore   Float
  sector            String
  rawChartUrl       String
  createdAt         DateTime @default(now())
}

model BrokerAccount {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerName       String
  accountNumberEnc String
  isApiConnected   Boolean           @default(false)
  supportedStyles  InvestmentStyle[]
  createdAt        DateTime          @default(now())
}

model Portfolio {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  totalValue  Float     @default(0.0)
  cashBalance Float     @default(0.0)
  holdings    Holding[]
  trades      Trade[]
}

model Holding {
  id            String     @id @default(uuid())
  portfolioId   String
  portfolio     Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker        String
  assetClass    AssetClass
  quantity      Float
  averagePrice  Float
  currentPrice  Float
  unrealizedPnL Float
  stopLossPrice Float?

  @@unique([portfolioId, ticker, assetClass])
}

model Trade {
  id                  String     @id @default(uuid())
  portfolioId         String
  portfolio           Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker              String
  assetClass          AssetClass
  side                TradeSide
  quantity            Float
  price               Float
  triggeredByStopLoss Boolean    @default(false)
  executedAt          DateTime   @default(now())
}
